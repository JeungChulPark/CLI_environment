<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS 2.6: shared memory with 64 MB segments (640x480 frames fit without fragmentation) + UDPv4 for discovery/remote -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
      <maxMessageSize>16777216</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_big</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>8388608</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shm_big_profile" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>shm_big</transport_id><transport_id>udp_big</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
