+void System::SaveLoopEdges(const string &filename)
+{
+    ofstream f(filename.c_str());
+    f << fixed;
+    Map* pCurrentMap = mpAtlas->GetCurrentMap();
+    if (!pCurrentMap)
+        return;
+    vector<KeyFrame*> vpKFs = pCurrentMap->GetAllKeyFrames();
+    for (KeyFrame* pKF : vpKFs)
+    {
+        if (!pKF || pKF->isBad())
+            continue;
+        set<KeyFrame*> edges = pKF->GetLoopEdges();
+        for (KeyFrame* pKF2 : edges)
+        {
+            if (!pKF2 || pKF2->isBad())
+                continue;
+            if (pKF2->mnId <= pKF->mnId)
+                continue;  // dedup undirected edge
+            Eigen::Vector3f c1 = pKF->GetCameraCenter();
+            Eigen::Vector3f c2 = pKF2->GetCameraCenter();
+            f << setprecision(6)
+              << c1(0) << " " << c1(1) << " " << c1(2) << " "
+              << c2(0) << " " << c2(1) << " " << c2(2) << endl;
+        }
+    }
+    f.close();
+}
