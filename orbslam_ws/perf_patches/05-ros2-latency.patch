+    // LATENCY: single background publisher thread. It owns the expensive
+    // PointCloud2 serialisation so the RGB-D sync callback never pays for it.
+    // Deliberately drop-on-busy: the dense map is a monitoring output, and a
+    // queue here would only convert a latency spike into unbounded memory.
+    void requestBackgroundPublish(const builtin_interfaces::msg::Time & stamp, double timestamp_sec)
+    {
+      {
+        std::lock_guard<std::mutex> lock(bg_publish_mutex_);
+        if (bg_publish_pending_) {
+          return;                       // previous round still running: skip
+        }
+        bg_publish_pending_ = true;
+        bg_publish_stamp_ = stamp;
+        bg_publish_time_sec_ = timestamp_sec;
+      }
+      if (!bg_publish_thread_.joinable()) {
+        bg_publish_thread_ = std::thread(&RgbdNode::backgroundPublishLoop, this);
+      }
+      bg_publish_cv_.notify_one();
+    }
+
+    void backgroundPublishLoop()
+    {
+      for (;;) {
+        builtin_interfaces::msg::Time stamp;
+        double timestamp_sec = 0.0;
+        {
+          std::unique_lock<std::mutex> lock(bg_publish_mutex_);
+          bg_publish_cv_.wait(lock, [this]{ return bg_publish_pending_ || bg_publish_stop_; });
+          if (bg_publish_stop_) {
+            return;
+          }
+          stamp = bg_publish_stamp_;
+          timestamp_sec = bg_publish_time_sec_;
+        }
+        publishDenseMapIfNeeded(stamp, timestamp_sec);
+        publishMapPointsIfNeeded(stamp, timestamp_sec);
+        {
+          std::lock_guard<std::mutex> lock(bg_publish_mutex_);
+          bg_publish_pending_ = false;
+        }
+      }
+    }
+
+    void stopBackgroundPublish()
+    {
+      {
+        std::lock_guard<std::mutex> lock(bg_publish_mutex_);
+        bg_publish_stop_ = true;
+      }
+      bg_publish_cv_.notify_all();
+      if (bg_publish_thread_.joinable()) {
+        bg_publish_thread_.join();
+      }
+    }
